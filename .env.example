# ============================================================
# Example environment file -- copy to .env for local development
# ============================================================
# Run:  cp .env.example .env
# Then edit .env with your own values. .env is gitignored and
# will never be committed -- only .env.example (this file, with
# no real secrets in it) is tracked in the repo.
# ============================================================

# Leave this as-is to use a local SQLite file with zero setup.
# In production (Render/Railway), this is overridden automatically
# by the platform when you attach a PostgreSQL database -- you
# don't need to set it yourself there.
DATABASE_URL=sqlite:///./silvopastoral.db

# Generate a real random value for production, e.g. with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-insecure-key-change-me

# Comma-separated list of frontend origins allowed to call this API.
# Add your GitHub Pages URL here once deployed.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://jabercqu.github.io
